@model AkinTeknik.Web.Models.Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-8">
    <div class="mb-6 border-b pb-4">
        <h1 class="text-2xl font-bold text-akinBlack">Yeni Kategori Ekle</h1>
        <p class="text-sm text-gray-500 mt-1">Sisteme yeni bir ürün kategorisi tanımlayın.</p>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
        
        <!-- Kategori Resmi -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Kategori Görseli <span class="text-red-500">*</span></label>
            <input type="file" name="imageFile" accept="image/*" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-akinRed focus:ring-akinRed sm:text-sm p-2 border" required />
            <p class="text-xs text-gray-400 mt-1">Kategori kutusunda görünecek ana fotoğrafı seçin.</p>
        </div>

        <!-- Kategori Adı -->
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700">Kategori Adı <span class="text-red-500">*</span></label>
            <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-akinRed focus:ring-akinRed sm:text-sm p-2 border" placeholder="Örn: Parlatma Keçeleri" required />
            <span asp-validation-for="Name" class="text-sm text-red-600"></span>
        </div>

        <!-- Description -->
        <div>
            <label asp-for="Description" class="block text-sm font-medium text-gray-700">Açıklama (Opsiyonel)</label>
            <textarea asp-for="Description" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-akinRed focus:ring-akinRed sm:text-sm p-2 border" placeholder="Kategori hakkında kısa bilgi..."></textarea>
            <span asp-validation-for="Description" class="text-sm text-red-600"></span>
        </div>

        <!-- Parent Category (Subcategory logic) -->
        <div>
            <label asp-for="ParentCategoryId" class="block text-sm font-medium text-gray-700">Üst Kategori (Opsiyonel)</label>
            <select asp-for="ParentCategoryId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-akinRed focus:ring-akinRed sm:text-sm p-2 border">
                <option value="">-- Bu bir Ana Kategoridir (Üst Kategorisi Yok) --</option>
                @if(ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories as IEnumerable<AkinTeknik.Web.Models.Category>)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
            <p class="text-xs text-gray-400 mt-1">Eğer bu bir alt kategori ise, ait olduğu ana kategoriyi seçin.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 bg-gray-50 border rounded-lg">
            <!-- Üst Menüde Göster -->
            <div class="flex items-center mt-6">
                <input asp-for="IsFeatured" type="checkbox" class="h-5 w-5 text-akinRed focus:ring-akinRed border-gray-300 rounded cursor-pointer" />
                <label asp-for="IsFeatured" class="ml-2 block text-sm font-bold text-gray-900 cursor-pointer">
                    Ana Sayfa Üst Menüde Göster
                </label>
            </div>

            <!-- Gösterim Sırası -->
            <div>
                <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700">Menü Gösterim Sırası</label>
                <input asp-for="DisplayOrder" type="number" value="1" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-akinRed focus:ring-akinRed sm:text-sm p-2 border" />
                <p class="text-xs text-gray-400 mt-1">Küçük rakamlar daha solda görünür (Örn: 1, 2, 3...)</p>
            </div>
        </div>

        <!-- Butonlar -->
        <div class="flex items-center justify-end space-x-4 pt-4 border-t">
            <a href="/Admin/Category/Index" class="text-sm font-medium text-gray-700 hover:text-gray-900">İptal</a>
            <button type="submit" class="bg-akinRed hover:bg-red-700 text-white font-bold py-2 px-6 rounded shadow transition duration-200">
                Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
