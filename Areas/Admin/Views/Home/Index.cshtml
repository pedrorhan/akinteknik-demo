@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-8">
    <h1 class="text-3xl font-black text-akinBlack">Hoş Geldiniz, Yönetici!</h1>
    <p class="text-gray-500 mt-2">Akın Teknik e-ticaret sisteminin kontrol merkezi.</p>
</div>

<!-- İstatistik Kartları -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Toplam Ürün -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-akinRed flex items-center justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Toplam Ürün</p>
            <p class="text-3xl font-bold text-gray-900 mt-1">@ViewBag.TotalProducts</p>
        </div>
        <div class="p-3 bg-red-100 rounded-full text-akinRed">
            <i class="fas fa-box-open text-2xl"></i>
        </div>
    </div>

    <!-- Toplam Kategori -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-akinBlack flex items-center justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Aktif Kategori</p>
            <p class="text-3xl font-bold text-gray-900 mt-1">@ViewBag.TotalCategories</p>
        </div>
        <div class="p-3 bg-gray-200 rounded-full text-akinBlack">
            <i class="fas fa-tags text-2xl"></i>
        </div>
    </div>

    <!-- Hızlı İşlem -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500 flex flex-col justify-center">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Hızlı İşlemler</p>
        <a href="/Admin/Product/Create" class="text-blue-600 hover:text-blue-800 font-bold text-sm mb-1"><i class="fas fa-plus mr-1"></i> Yeni Ürün Ekle</a>
        <a href="/Admin/Category/Create" class="text-blue-600 hover:text-blue-800 font-bold text-sm"><i class="fas fa-plus mr-1"></i> Yeni Kategori Ekle</a>
    </div>
</div>

<!-- Karşılama Paneli -->
<div class="bg-white rounded-lg shadow-md p-8 border border-gray-100">
    <h2 class="text-xl font-bold mb-4">Sistem Durumu</h2>
    <p class="text-gray-600 mb-4">E-ticaret sisteminiz sorunsuz bir şekilde çalışmaktadır. Sol üstteki menüden Kategoriler ve Ürünler sekmelerine tıklayarak katalog yönetimine başlayabilirsiniz.</p>
    
    <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold"><i class="fas fa-info-circle mr-1"></i> Bilgi:</strong>
        <span class="block sm:inline">6 ay sonraki ödeme (Sanal Pos) entegrasyonu için veritabanı altyapısı hazırlandı. Şu anki aşamada siparişler doğrudan WhatsApp üzerinden alınacaktır.</span>
    </div>
</div>
