@model AkinTeknik.Web.Models.Slider

@{
    ViewData["Title"] = "Yeni Slider Ekle";
}

<div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-8">
    <div class="mb-6 border-b pb-4">
        <h1 class="text-2xl font-bold text-akinBlack">Yeni Slider Görseli Ekle</h1>
        <p class="text-sm text-gray-500 mt-1">Ana sayfada dönecek görsellerden birini ekleyin.</p>
    </div>

    <form action="/Admin/Slider/Create" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()
        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Görsel (Önerilen: 1200x400) <span class="text-red-500">*</span></label>
            <input type="file" name="imageFile" accept="image/*" class="w-full border border-gray-300 rounded p-2 focus:ring-akinRed focus:border-akinRed" required />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Yönlendirme Linki (Tıklanınca Gidilecek Adres)</label>
            <input type="text" name="TargetUrl" class="w-full border border-gray-300 rounded p-2 focus:ring-akinRed focus:border-akinRed" placeholder="Örn: /#kategoriler veya /Urun/elmas-ege" />
            <p class="text-xs text-gray-500 mt-1">Görsele tıklandığında bir yere gitmesini istemiyorsanız boş bırakın.</p>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Gösterim Sırası</label>
            <input type="number" name="DisplayOrder" value="1" class="w-full border border-gray-300 rounded p-2 focus:ring-akinRed focus:border-akinRed" />
        </div>

        <div class="flex justify-end pt-4 border-t">
            <a href="/Admin/Slider/Index" class="mr-4 py-2 px-4 text-gray-600 hover:text-gray-900">İptal</a>
            <button type="submit" class="bg-akinBlack hover:bg-akinRed text-white font-bold py-2 px-6 rounded shadow transition-colors">
                <i class="fas fa-save mr-2"></i> Kaydet
            </button>
        </div>
    </form>
</div>
