@model IEnumerable<AkinTeknik.Web.Models.Slider>

@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-akinBlack">Slider Yönetimi</h1>
        <a href="/Admin/Slider/Create" class="bg-akinRed hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition duration-200">
            <i class="fas fa-plus mr-2"></i> Yeni Görsel Ekle
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var slider in Model)
            {
                <div class="border rounded-lg overflow-hidden shadow-sm relative group">
                    <img src="@slider.ImageUrl" alt="Slayt Sıra @slider.DisplayOrder Görseli" class="w-full h-48 object-cover" />
                    
                    <div class="p-4 bg-gray-50">
                        <p class="text-sm font-semibold text-gray-700 truncate mb-1">
                            Yönlendirme: @(string.IsNullOrEmpty(slider.TargetUrl) ? "Yok" : slider.TargetUrl)
                        </p>
                        <p class="text-xs text-gray-500 mb-4">Sıra: @slider.DisplayOrder</p>
                        
                        <div class="grid grid-cols-2 gap-2">
                            <a href="/Admin/Slider/Edit/@slider.Id"
                                class="flex items-center justify-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-3 rounded transition-colors text-sm">
                                <i class="fas fa-edit mr-1.5 text-blue-600"></i> Düzenle
                            </a>
                            <form action="/Admin/Slider/Delete" method="post" onsubmit="return confirm('Bu görseli silmek istediğinize emin misiniz?');" class="w-full">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@slider.Id" />
                                <button type="submit" class="w-full flex items-center justify-center bg-red-100 hover:bg-red-200 text-red-700 font-bold py-2 px-3 rounded transition-colors text-sm">
                                    <i class="fas fa-trash mr-1.5"></i> Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
            <i class="fas fa-images text-4xl text-gray-400 mb-3"></i>
            <h3 class="text-lg font-medium text-gray-900">Henüz slider görseli eklenmemiş</h3>
            <p class="text-gray-500 mt-1">Ana sayfada müşterileri karşılayacak etkileyici görseller ekleyin.</p>
        </div>
    }
</div>
