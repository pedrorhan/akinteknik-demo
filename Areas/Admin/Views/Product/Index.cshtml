@model IEnumerable<AkinTeknik.Web.Models.Product>

@{
    ViewData["Title"] = "Ürün Yönetimi";
}

<div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-akinBlack">Ürünler</h1>
        <a href="/Admin/Product/Create" class="bg-akinRed hover:bg-red-700 text-white font-bold py-2 px-4 rounded shadow transition duration-200">
            <i class="fas fa-plus mr-2"></i> Yeni Ürün
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="w-10"></th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Görsel</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ürün Adı</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kategori</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Varsayılan Ölçü</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fiyat</th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">İşlemler</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200" id="productAccordion">
                @if(Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var hasVariants = item.ProductSizes != null && item.ProductSizes.Any();
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-4 text-center">
                                @if(hasVariants)
                                {
                                    <button onclick="toggleVariant('@item.Id')" class="text-gray-500 hover:text-akinRed focus:outline-none">
                                        <i id="icon-@item.Id" class="fas fa-chevron-down transition-transform duration-200"></i>
                                    </button>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Id</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if(!string.IsNullOrEmpty(item.ImageUrl)){
                                    <img src="@item.ImageUrl" alt="@item.Name Görseli" class="h-10 w-10 object-cover rounded shadow-sm" />
                                }else{
                                    <div class="h-10 w-10 bg-gray-200 rounded flex items-center justify-center text-xs text-gray-400">Yok</div>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">@item.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @(item.Category != null ? item.Category.Name : "Kategorisiz")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded text-xs font-semibold border">@(string.IsNullOrEmpty(item.Dimensions) ? "Belirtilmemiş" : item.Dimensions)</span>
                                @if(hasVariants){
                                    <span class="ml-2 text-xs text-blue-600 font-bold">+@item.ProductSizes.Count Varyant</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Price.ToString("C")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="/Admin/Product/Edit/@item.Id" class="text-indigo-600 hover:text-indigo-900 mr-3"><i class="fas fa-edit"></i> Düzenle</a>
                                <form action="/Admin/Product/Delete/@item.Id" method="post" class="inline-block" onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-900"><i class="fas fa-trash"></i> Sil</button>
                                </form>
                            </td>
                        </tr>
                        
                        <!-- Accordion Variant Row -->
                        @if(hasVariants)
                        {
                            <tr id="variants-@item.Id" class="hidden bg-gray-50 shadow-inner">
                                <td colspan="8" class="px-10 py-4">
                                    <div class="rounded-md border border-gray-200 bg-white overflow-hidden">
                                        <table class="min-w-full divide-y divide-gray-100">
                                            <thead class="bg-gray-100">
                                                <tr>
                                                    <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Ölçü/Varyant</th>
                                                    <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Ekstra Görsel</th>
                                                    <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Fiyat</th>
                                                    <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Stok</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-100">
                                                @foreach(var v in item.ProductSizes)
                                                {
                                                    <tr>
                                                        <td class="px-4 py-2 text-sm text-gray-700 font-medium">@v.Size</td>
                                                        <td class="px-4 py-2 text-sm">
                                                            @if(!string.IsNullOrEmpty(v.ImageUrl)){
                                                                <img src="@v.ImageUrl" alt="@v.Size Varyant Görseli" class="h-6 w-6 object-cover rounded" />
                                                            }else{
                                                                <span class="text-gray-400 text-xs">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-2 text-sm text-green-600 font-semibold">@v.Price.ToString("C")</td>
                                                        <td class="px-4 py-2 text-sm text-gray-600">@v.Stock Adet</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-500">Henüz hiç ürün eklenmemiş.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function toggleVariant(id) {
        var row = document.getElementById('variants-' + id);
        var icon = document.getElementById('icon-' + id);
        
        if (row.classList.contains('hidden')) {
            row.classList.remove('hidden');
            icon.classList.add('rotate-180');
        } else {
            row.classList.add('hidden');
            icon.classList.remove('rotate-180');
        }
    }
</script>
