@model AkinTeknik.Web.Models.About

@{
    ViewData["Title"] = "Hakkımızda Sayfası Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="max-w-5xl mx-auto py-6">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-200">
        <div>
            <h1 class="text-2xl font-black text-gray-900">Hakkımızda Sayfası Yönetimi</h1>
            <p class="text-sm text-gray-500 mt-1">Sitenizdeki "Hakkımızda" bölümünde yer alan tüm metinleri, görselleri ve istatistikleri buradan güncelleyebilirsiniz.</p>
        </div>
        <a href="/Home/About" target="_blank" class="inline-flex items-center text-sm font-bold text-akinRed hover:underline">
            <i class="fas fa-external-link-alt mr-2"></i> Sayfayı Görüntüle
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center shadow-sm">
            <i class="fas fa-check-circle mr-3 text-lg text-green-500"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <form action="/Admin/About/Save" method="post" enctype="multipart/form-data" class="space-y-8">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@(Model?.Id ?? 0)" />
        <input type="hidden" name="ImageUrl" value="@Model?.ImageUrl" />
        <input type="hidden" name="SecondaryImageUrl" value="@Model?.SecondaryImageUrl" />

        <!-- 1. Temel Kurumsal Başlıklar -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-6 flex items-center">
                <i class="fas fa-heading text-akinRed mr-3"></i> Ana Başlıklar & Hikaye
            </h3>

            <div class="space-y-5">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Ana Başlık</label>
                    <input type="text" name="Title" value="@Model?.Title" required
                        placeholder="Örn: Endüstriyel Kalıp ve Parlatma Çözümlerinde Güvenilir İş Ortağınız"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Alt Başlık (Vurgulu Özet)</label>
                    <input type="text" name="SubTitle" value="@Model?.SubTitle"
                        placeholder="Örn: Çeyrek asırlık tecrübe, kesintisiz stok ve yüksek kalite standartları."
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Detaylı Kurumsal Metin / Hikaye</label>
                    <textarea name="Content" rows="6" required
                        placeholder="Paragraflar arasında bir satır boşluk bırakarak firmanızın hikayesini, tecrübesini ve kalitesini anlatın..."
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm leading-relaxed">@Model?.Content</textarea>
                    <span class="text-xs text-gray-400 mt-1 block">Paragraflar arasına 'Enter' basarak boşluk bırakabilirsiniz; sitede otomatik olarak ayrı paragraflar halinde listelenecektir.</span>
                </div>
            </div>
        </div>

        <!-- 2. Görseller -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-6 flex items-center">
                <i class="fas fa-images text-akinRed mr-3"></i> Fotoğraf ve Görseller
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Ana Görsel -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Ana Kurumsal Fotoğraf</label>
                    @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                    {
                        <div class="mb-3 w-full h-40 rounded-xl overflow-hidden border border-gray-200 bg-gray-50">
                            <img src="@Model.ImageUrl" alt="Mevcut Ana Kurumsal Fotoğraf" class="w-full h-full object-cover" />
                        </div>
                    }
                    <input type="file" name="MainImageFile" accept="image/*"
                        class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-red-50 file:text-akinRed hover:file:bg-red-100 cursor-pointer" />
                    <span class="text-xs text-gray-400 mt-1 block">Yeni fotoğraf yüklerseniz mevcut görsel güncellenir.</span>
                </div>

                <!-- İkincil Görsel (Atölye/Detay) -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">İkincil / Atölye Fotoğrafı (Köşe Rozeti)</label>
                    @if (!string.IsNullOrEmpty(Model?.SecondaryImageUrl))
                    {
                        <div class="mb-3 w-full h-40 rounded-xl overflow-hidden border border-gray-200 bg-gray-50">
                            <img src="@Model.SecondaryImageUrl" alt="Mevcut Atölye / Detay Fotoğrafı" class="w-full h-full object-cover" />
                        </div>
                    }
                    <input type="file" name="SecondaryImageFile" accept="image/*"
                        class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" />
                    <span class="text-xs text-gray-400 mt-1 block">Ana görselin sağ altında küçük pencere olarak gözükür.</span>
                </div>
            </div>
        </div>

        <!-- 3. Misyon & Vizyon -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-6 flex items-center">
                <i class="fas fa-compass text-akinRed mr-3"></i> Misyon & Vizyon
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Misyonumuz</label>
                    <textarea name="Mission" rows="4"
                        placeholder="Müşterilerimize ve sanayiye sunduğumuz katkı..."
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm">@Model?.Mission</textarea>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Vizyonumuz</label>
                    <textarea name="Vision" rows="4"
                        placeholder="Gelecekte ulaşmak istediğimiz lider konum..."
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm">@Model?.Vision</textarea>
                </div>
            </div>
        </div>

        <!-- 4. İstatistik Sayaçları -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-6 flex items-center">
                <i class="fas fa-chart-line text-akinRed mr-3"></i> Sayılarla Akın Teknik (İstatistikler)
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tecrübe</label>
                    <input type="text" name="ExperienceYears" value="@(Model?.ExperienceYears ?? "25+")"
                        placeholder="Örn: 25+"
                        class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-akinRed focus:border-akinRed text-sm" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Ürün Çeşidi</label>
                    <input type="text" name="ProductCount" value="@(Model?.ProductCount ?? "1500+")"
                        placeholder="Örn: 1500+"
                        class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-akinRed focus:border-akinRed text-sm" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Müşteri Ağı</label>
                    <input type="text" name="CustomerCount" value="@(Model?.CustomerCount ?? "500+")"
                        placeholder="Örn: 500+"
                        class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-akinRed focus:border-akinRed text-sm" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Memnuniyet</label>
                    <input type="text" name="SatisfactionRate" value="@(Model?.SatisfactionRate ?? "%100")"
                        placeholder="Örn: %100"
                        class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-akinRed focus:border-akinRed text-sm" />
                </div>
            </div>
        </div>

        <!-- Kaydet Butonu -->
        <div class="flex justify-end gap-4">
            <button type="submit"
                class="bg-akinRed hover:bg-red-700 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg transition-all flex items-center text-base">
                <i class="fas fa-save mr-2"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</div>
