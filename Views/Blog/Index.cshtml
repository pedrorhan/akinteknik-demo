@model IEnumerable<AkinTeknik.Web.Models.BlogPost>

@{
    ViewData["Title"] = "Kalıpçılık & Parlatma Teknik Rehberleri";
    ViewData["Description"] = "Kalıp parlatma incelikleri, elmas eğe kullanımı ve yüzey işleme tekniklerine dair uzman mühendislik rehberleri ve sektörel makaleler.";
    ViewData["Keywords"] = "kalıp parlatma rehberi, elmas eğe nasıl kullanılır, kalıp sarf malzemesi makaleleri, parlatma teknikleri";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center space-x-2" aria-label="Gezinti Yolu">
        <a href="/" class="hover:text-akinRed transition-colors" aria-label="Ana Sayfa"><i class="fas fa-home" aria-hidden="true"></i></a>
        <span><i class="fas fa-chevron-right text-xs" aria-hidden="true"></i></span>
        <span class="text-akinBlack font-bold">Blog & Teknik Rehberler</span>
    </nav>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-10 pb-4 border-b border-gray-100 gap-4">
        <div>
            <h1 class="text-3xl font-black text-akinBlack">Blog & Teknik Rehberler</h1>
            <p class="text-sm text-gray-500 mt-1">Kalıp parlatma teknikleri, sarf malzeme seçimleri ve sektörel yenilikler.</p>
        </div>
        <span class="text-xs font-semibold text-gray-500 bg-gray-100 px-3 py-1.5 rounded-full">
            Toplam @(Model?.Count() ?? 0) Makale
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var post in Model)
            {
                <article class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col group">
                    <!-- Kapak Görseli -->
                    <a href="/Blog/@post.Slug" class="block aspect-[16/9] bg-gray-100 overflow-hidden relative">
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" alt="@post.Title - Akın Teknik Blog" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-gray-50 text-gray-300">
                                <i class="fas fa-newspaper text-5xl"></i>
                            </div>
                        }
                        <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-akinBlack text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                            <i class="far fa-calendar-alt text-akinRed mr-1"></i> @post.CreatedAt.ToString("dd MMM yyyy")
                        </div>
                    </a>

                    <!-- İçerik Alanı -->
                    <div class="p-6 flex flex-col flex-grow">
                        <h2 class="text-xl font-bold text-gray-900 group-hover:text-akinRed transition-colors leading-snug mb-3">
                            <a href="/Blog/@post.Slug">
                                @post.Title
                            </a>
                        </h2>

                        @if (!string.IsNullOrEmpty(post.Summary))
                        {
                            <p class="text-sm text-gray-600 line-clamp-3 leading-relaxed mb-4">
                                @post.Summary
                            </p>
                        }

                        <!-- Alt Buton -->
                        <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold">
                            <span class="text-gray-400">Akın Teknik Blog</span>
                            <a href="/Blog/@post.Slug" class="text-akinRed group-hover:translate-x-1 transition-transform inline-flex items-center">
                                Devamını Oku <i class="fas fa-arrow-right ml-1.5 text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 p-8">
            <i class="fas fa-feather-alt text-5xl text-gray-300 mb-4"></i>
            <h3 class="text-lg font-bold text-gray-700">Henüz yayınlanmış bir makale bulunmuyor</h3>
            <p class="text-sm text-gray-500 mt-2">Çok yakında teknik rehberlerimiz ve faydalı yazılarımız burada listelenecektir.</p>
            <a href="/" class="mt-6 inline-flex items-center text-sm font-bold text-akinRed hover:underline">
                <i class="fas fa-home mr-2"></i> Ana Sayfaya Dön
            </a>
        </div>
    }
</div>
