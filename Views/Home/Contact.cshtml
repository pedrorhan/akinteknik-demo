@{
    ViewData["Title"] = "İletişim, Depo & Satış Noktası";
    ViewData["Description"] = "Akın Teknik Eyüpsultan merkez depomuz ile iletişime geçin. Yol tarifi, telefon, e-posta bilgileri ve anında WhatsApp teklif hattı.";
    ViewData["Keywords"] = "akın teknik iletişim, akın teknik adres, kalıp malzemeleri eyüpsultan, bilge iş merkezi, parlatma ekipmanları telefon";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4 flex items-center space-x-2" aria-label="Gezinti Yolu">
        <a href="/" class="hover:text-akinRed transition-colors" aria-label="Ana Sayfa"><i class="fas fa-home" aria-hidden="true"></i></a>
        <span><i class="fas fa-chevron-right text-xs" aria-hidden="true"></i></span>
        <span class="text-akinBlack font-bold">İletişim</span>
    </nav>

    <h1 class="text-2xl font-black text-akinBlack mb-8 border-b pb-4">İletişim & Konum Bilgileri</h1>

    <!-- Başarı Bildirimi -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-8 bg-green-50 border border-green-200 text-green-800 px-5 py-4 rounded-xl flex items-center shadow-sm">
            <i class="fas fa-check-circle text-2xl text-green-500 mr-3"></i>
            <div>
                <h4 class="font-bold">Mesajınız Alındı!</h4>
                <p class="text-sm text-green-700">@TempData["Success"]</p>
            </div>
        </div>
    }

    <!-- Hata Bildirimi -->
    @if (TempData["Error"] != null)
    {
        <div class="mb-8 bg-red-50 border border-red-200 text-red-800 px-5 py-4 rounded-xl flex items-center shadow-sm">
            <i class="fas fa-exclamation-circle text-2xl text-red-500 mr-3"></i>
            <div>
                <h4 class="font-bold">Mesaj İletilemedi</h4>
                <p class="text-sm text-red-700">@TempData["Error"]</p>
            </div>
        </div>
    }

    <!-- 1. ÜST BÖLÜM (YAN YANA): İletişim Bilgileri (Sol) & Canlı Harita (Sağ) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-stretch">
        
        <!-- Sol: İletişim Detayları & WhatsApp (5 Kolon) -->
        <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
            
            <!-- Bilgiler Kartı -->
            <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-7 border border-gray-100 flex-grow">
                <h3 class="text-lg font-bold text-gray-900 mb-6 border-b pb-3 flex items-center">
                    <i class="fas fa-id-card text-akinRed mr-2.5"></i> İletişim Bilgilerimiz
                </h3>

                <div class="space-y-5">
                    <!-- Adres -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 bg-red-50 p-2.5 rounded-xl text-akinRed">
                            <i class="fas fa-map-marker-alt text-lg w-5 text-center"></i>
                        </div>
                        <div class="ml-3.5">
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Merkez Ofis & Depo</p>
                            <p class="text-sm font-semibold text-gray-800 mt-0.5 leading-snug">
                                İkitelli OSB Mah. Demirciler Sanayi Sitesi 7. Cadde No: 42<br/>34490 Başakşehir / İstanbul
                            </p>
                        </div>
                    </div>

                    <!-- Telefon -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 bg-red-50 p-2.5 rounded-xl text-akinRed">
                            <i class="fas fa-phone-alt text-lg w-5 text-center"></i>
                        </div>
                        <div class="ml-3.5">
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Müşteri Hattı</p>
                            <a href="tel:+905550000000" class="text-sm font-bold text-gray-900 hover:text-akinRed transition-colors mt-0.5 inline-block">
                                +90 555 000 00 00
                            </a>
                        </div>
                    </div>

                    <!-- E-Posta -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 bg-red-50 p-2.5 rounded-xl text-akinRed">
                            <i class="fas fa-envelope text-lg w-5 text-center"></i>
                        </div>
                        <div class="ml-3.5">
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">E-Posta</p>
                            <a href="mailto:info@demoteknik.com" class="text-sm font-bold text-gray-900 hover:text-akinRed transition-colors mt-0.5 inline-block">
                                info@demoteknik.com
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Sosyal Medya -->
                <div class="mt-6 pt-5 border-t border-gray-100">
                    <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2.5">Sosyal Medya</p>
                    <div class="flex gap-3">
                        <a href="https://www.instagram.com/" target="_blank"
                            class="flex-1 bg-gradient-to-r from-purple-600 to-pink-600 hover:opacity-95 text-white font-bold py-2 px-3 rounded-xl text-xs flex items-center justify-center gap-2 shadow-sm transition-all">
                            <i class="fab fa-instagram text-sm"></i>
                            <span>Instagram</span>
                        </a>
                        <a href="https://www.facebook.com/" target="_blank"
                            class="flex-1 bg-[#1877F2] hover:opacity-95 text-white font-bold py-2 px-3 rounded-xl text-xs flex items-center justify-center gap-2 shadow-sm transition-all">
                            <i class="fab fa-facebook-f text-sm"></i>
                            <span>Facebook</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- WhatsApp Kutusu -->
            <div class="bg-gradient-to-br from-gray-900 to-akinBlack text-white rounded-2xl shadow-sm p-5 sm:p-6 border border-gray-800">
                <div class="flex items-center justify-between gap-3 mb-2">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center text-lg">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <h4 class="text-base font-bold">Hızlı Teklif & WhatsApp</h4>
                    </div>
                    <span class="text-[11px] bg-green-500/20 text-green-400 font-bold px-2 py-0.5 rounded-full border border-green-500/30">7/24 Aktif</span>
                </div>
                <p class="text-xs text-gray-400 mb-4 leading-relaxed">
                    Toptan sarf malzeme talepleriniz için WhatsApp'tan hemen fiyat alabilirsiniz.
                </p>
                <a href="https://wa.me/905550000000" target="_blank"
                    class="block w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs sm:text-sm transition-colors flex items-center justify-center gap-2 shadow-md">
                    <i class="fab fa-whatsapp text-lg"></i>
                    <span>WhatsApp Sohbeti Başlat</span>
                </a>
            </div>
        </div>

        <!-- Sağ: Doğrudan Harita (7 Kolon) -->
        <div class="lg:col-span-7">
            <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100 h-full min-h-[420px] flex flex-col">
                <!-- Harita Başlık Çubuğu -->
                <div class="px-5 py-3.5 bg-gray-50 border-b border-gray-100 flex items-center justify-between text-xs">
                    <span class="text-gray-700 font-bold flex items-center">
                        <i class="fas fa-map-marked-alt text-akinRed text-sm mr-2"></i> Firma Konumu (İkitelli OSB)
                    </span>
                    <a href="https://maps.google.com/?q=Ikitelli+Organize+Sanayi+Bolgesi+Istanbul" target="_blank"
                        class="text-akinRed font-bold hover:underline flex items-center">
                        <span>Yol Tarifi Al</span>
                        <i class="fas fa-external-link-alt ml-1 text-[10px]"></i>
                    </a>
                </div>

                <!-- Google Haritalar Embed -->
                <div class="w-full flex-grow min-h-[350px]">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12030.564753086915!2d28.7845!3d41.0715!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caa5a308ef618f%3A0xc3b10b659cbe7465!2zxLBraXRlbGxpIE9yZ2FuaXplIFNhbmF5aSBCw7Zss2dlc2ksIEJhyZ9ha8WfZWhpci_EsHN0YW5idWw!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str"
                        title="İkitelli OSB Kalıp Sanayi Bölgesi Haritası"
                        class="w-full h-full border-0"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>

                <!-- Alt Adres İpucu -->
                <div class="px-4 py-2.5 bg-white border-t border-gray-100 text-[11px] text-gray-500 flex items-center justify-between">
                    <span><i class="fas fa-building text-gray-400 mr-1"></i> Demirciler Sanayi Sitesi No: 42, Başakşehir</span>
                    <span class="text-gray-400">Merkez Depo & Satış (Demo)</span>
                </div>
            </div>
        </div>

    </div>

    <!-- 2. ALT BÖLÜM: Geniş ve Ferah Mail İletişim Formu -->
    <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-10 border border-gray-100">
        <div class="max-w-3xl mb-8">
            <h3 class="text-xl sm:text-2xl font-black text-gray-900 mb-2 flex items-center">
                <i class="fas fa-paper-plane text-akinRed mr-3"></i> Bize Mesaj Bırakın
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed">
                İhtiyacınız olan kalıp sarf malzemeleri, özel parlatma keçesi ölçüleri veya toptan fiyat talepleriniz için aşağıdaki formu doldurabilirsiniz. Uzman kadromuz mesajınıza en kısa sürede geri dönüş sağlayacaktır.
            </p>
        </div>

        <form action="/Home/SendMessage" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Bot Koruması (Honeypot) - İnsan kullanıcılar görmez, botlar doldurur -->
            <div class="hidden" style="display:none !important;" aria-hidden="true">
                <label for="contactWebsite">Web Sitesi</label>
                <input type="text" id="contactWebsite" name="Website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <!-- Ad Soyad -->
                <div>
                    <label for="contactFullName" class="block text-xs font-bold text-gray-700 uppercase mb-2">Adınız Soyadınız <span class="text-akinRed">*</span></label>
                    <input type="text" id="contactFullName" name="FullName" required placeholder="Örn: Ahmet Yılmaz"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm transition-all shadow-sm" />
                </div>

                <!-- Telefon -->
                <div>
                    <label for="contactPhone" class="block text-xs font-bold text-gray-700 uppercase mb-2">Telefon Numaranız <span class="text-akinRed">*</span></label>
                    <input type="tel" id="contactPhone" name="Phone" required placeholder="Örn: 0530 000 00 00"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm transition-all shadow-sm" />
                </div>

                <!-- E-Posta -->
                <div>
                    <label for="contactEmail" class="block text-xs font-bold text-gray-700 uppercase mb-2">E-Posta Adresiniz <span class="text-akinRed">*</span></label>
                    <input type="email" id="contactEmail" name="Email" required placeholder="Örn: ahmet@sirketiniz.com"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm transition-all shadow-sm" />
                </div>

                <!-- Konu -->
                <div>
                    <label for="contactSubject" class="block text-xs font-bold text-gray-700 uppercase mb-2">Konu</label>
                    <input type="text" id="contactSubject" name="Subject" placeholder="Örn: Fiyat Teklifi / Stok"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm transition-all shadow-sm" />
                </div>
            </div>

            <!-- Mesaj Alanı -->
            <div>
                <label for="contactMessage" class="block text-xs font-bold text-gray-700 uppercase mb-2">Mesajınız & Talep Detayları <span class="text-akinRed">*</span></label>
                <textarea id="contactMessage" name="Message" rows="4" required placeholder="İhtiyacınız olan ürünler, adetler veya sormak istediğiniz soruları buraya yazabilirsiniz..."
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-akinRed focus:border-akinRed text-sm transition-all leading-relaxed shadow-sm"></textarea>
            </div>

            <!-- Gönder Butonu -->
            <div class="flex justify-end pt-2">
                <button type="submit"
                    class="w-full sm:w-auto bg-akinRed hover:bg-red-700 text-white font-bold py-3.5 px-10 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2.5 text-sm">
                    <i class="fas fa-paper-plane"></i>
                    <span>Mesajı Gönder</span>
                </button>
            </div>
        </form>
    </div>

</div>
