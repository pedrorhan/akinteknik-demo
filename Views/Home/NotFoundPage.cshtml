@{
    ViewData["Title"] = "404 - Sayfa Bulunamadı | Akın Teknik";
    ViewData["Description"] = "Aradığınız sayfa bulunamadı veya taşınmış olabilir. Akın Teknik kalıp elemanları ve parlatma ekipmanları kataloğuna göz atabilirsiniz.";
    ViewData["Robots"] = "noindex, follow";
    var categories = ViewBag.Categories as List<AkinTeknik.Web.Models.Category>;
}

<div class="py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Ana Beyaz Kart -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 sm:p-12 text-center relative overflow-hidden">

            <div class="relative z-10 max-w-2xl mx-auto space-y-6">
                
                <!-- 404 Rakamı ve Rozet -->
                <div class="space-y-3">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-red-50 border border-red-200 text-akinRed text-xs sm:text-sm font-bold shadow-sm">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Sayfa Bulunamadı (Hata 404)</span>
                    </div>

                    <h1 class="text-7xl sm:text-9xl font-black text-akinRed tracking-tight select-none">
                        404
                    </h1>
                </div>

                <!-- Başlık ve Açıklama -->
                <div class="space-y-3">
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
                        Aradığınız Sayfa Bulunamadı veya Taşınmış Olabilir
                    </h2>
                    <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
                        Tıkladığınız bağlantı eski olabilir, bir harf hatası yapılmış olabilir veya sayfa sistemimizden kaldırılmış olabilir. 
                        Aşağıdaki arama çubuğunu veya hızlı butonları kullanarak aradığınız ürüne hemen ulaşabilirsiniz.
                    </p>
                </div>

                <!-- Hızlı Ürün Arama Kutusu -->
                <form action="/Product" method="get" class="max-w-lg mx-auto relative mt-2" role="search">
                    <input type="text" name="q" placeholder="Ürün veya kategori ara..." 
                           class="w-full bg-gray-50 border border-gray-300 rounded-2xl py-3.5 pl-11 pr-24 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-akinRed focus:border-akinRed focus:bg-white transition-all shadow-sm" />
                    <i class="fas fa-search absolute left-4 top-4 text-gray-400 text-sm"></i>
                    <button type="submit" 
                            class="absolute right-2 top-2 bg-akinBlack hover:bg-akinRed text-white text-xs sm:text-sm font-bold px-4 py-2 rounded-xl transition-colors">
                        Ara
                    </button>
                </form>

                <!-- Hızlı Aksiyon Butonları -->
                <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
                    <a href="/" 
                       class="inline-flex items-center gap-2 bg-akinRed hover:bg-red-700 text-white font-bold px-6 py-3 rounded-xl shadow-md hover:shadow-lg transition-all text-sm sm:text-base">
                        <i class="fas fa-home"></i>
                        <span>Ana Sayfaya Dön</span>
                    </a>

                    <a href="/Product" 
                       class="inline-flex items-center gap-2 bg-akinBlack hover:bg-gray-800 text-white font-bold px-6 py-3 rounded-xl shadow-md hover:shadow-lg transition-all text-sm sm:text-base">
                        <i class="fas fa-boxes"></i>
                        <span>Tüm Ürünler</span>
                    </a>

                    <a href="https://wa.me/905550000000?text=Merhaba,%20sitenizde%20aradığım%20bir%20ürünü%20bulamadım,%20yardımcı%20olur%20musunuz?" 
                       target="_blank" 
                       rel="noopener noreferrer"
                       class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl shadow-md hover:shadow-lg transition-all text-sm sm:text-base">
                        <i class="fab fa-whatsapp text-lg"></i>
                        <span>WhatsApp ile Bize Sorun</span>
                    </a>
                </div>

                <!-- Popüler Kategoriler -->
                @if (categories != null && categories.Any())
                {
                    <div class="pt-6 mt-6 border-t border-gray-100 text-left">
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-xs font-bold uppercase tracking-wider text-gray-500 flex items-center gap-2">
                                <i class="fas fa-compass text-akinRed"></i>
                                Popüler Kategorilerimize Göz Atın
                            </span>
                            <a href="/Category" class="text-xs text-akinRed hover:underline font-bold">Tüm Kategoriler &rarr;</a>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            @foreach (var cat in categories)
                            {
                                <a href="/Kategori/@cat.Slug" 
                                   class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 hover:bg-red-50/50 border border-gray-200 hover:border-akinRed text-gray-800 hover:text-akinRed transition-all duration-200 group">
                                    <div class="w-8 h-8 rounded-lg bg-white border border-gray-200 group-hover:border-red-200 text-gray-500 group-hover:text-akinRed flex items-center justify-center shrink-0 transition-colors shadow-sm">
                                        <i class="fas fa-layer-group text-xs"></i>
                                    </div>
                                    <span class="text-xs sm:text-sm font-semibold truncate">@cat.Name</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Destek İletişim Bilgisi -->
                <div class="text-xs text-gray-500 pt-4 border-t border-gray-100 flex flex-wrap items-center justify-center gap-3 sm:gap-6">
                    <span>Aradığınız özel bir kalıp parçası mı var?</span>
                    <a href="tel:+905550000000" class="text-gray-800 hover:text-akinRed font-bold inline-flex items-center gap-1.5 transition-colors">
                        <i class="fas fa-phone text-akinRed"></i> +90 555 000 00 00
                    </a>
                    <span class="text-gray-300 hidden sm:inline">&bull;</span>
                    <a href="mailto:info@akinteknik.com" class="text-gray-800 hover:text-akinRed font-bold inline-flex items-center gap-1.5 transition-colors">
                        <i class="fas fa-envelope text-akinRed"></i> info@akinteknik.com
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
