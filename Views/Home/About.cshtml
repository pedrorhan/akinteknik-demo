@model AkinTeknik.Web.Models.About

@{
    ViewData["Title"] = "Hakkımızda & Kuzey Parlatma Ekipmanları";
    ViewData["Description"] = "Çeyrek asırlık sanayi tecrübesiyle Akın Teknik ve tescilli markamız KUZEY hakkında bilgi edinin. Kalite politikamız, misyonumuz ve üretim gücümüz.";
    ViewData["Keywords"] = "hakkımızda, akın teknik tarihçe, kuzey parlatma ekipmanları, endüstriyel kalıpçılık tecrübesi";

    // Dinamik veritabanı verisi yoksa veya ilk kurulumda boşsa gösterilecek kurumsal varsayılanlar:
    var title = !string.IsNullOrEmpty(Model?.Title) ? Model.Title : "Endüstriyel Kalıp ve Parlatma Çözümlerinde Güvenilir İş Ortağınız";
    var subTitle = !string.IsNullOrEmpty(Model?.SubTitle) ? Model.SubTitle : "Çeyrek asırlık tecrübe, kesintisiz stok ve yüksek kalite standartları.";
    var content = !string.IsNullOrEmpty(Model?.Content) ? Model.Content : "Akın Teknik Hırdavat olarak, kurulduğumuz günden bu yana Türk sanayisinin ve imalat sektörünün ihtiyaç duyduğu yüksek hassasiyetli kalıp elemanları, elmas eğeler, parlatma keçeleri ve özel teknik sarf malzemelerin tedarikinde öncü bir rol üstleniyoruz.\n\nSektördeki uzun yıllara dayanan birikimimiz ve uzman teknik kadromuzla, sadece bir satıcı değil; atölyenizdeki, fabrikanızdaki üretimin aksamadan devam etmesini sağlayan stratejik bir çözüm ortağıyız. İthalatını ve dağıtımını üstlendiğimiz birinci sınıf ürünler ile kaliteden asla ödün vermiyoruz.";
    var mission = !string.IsNullOrEmpty(Model?.Mission) ? Model.Mission : "İmalat ve kalıp sektöründeki müşterilerimize uluslararası kalite standartlarına uygun, güvenilir ve yenilikçi sarf malzemeleri en rekabetçi koşullarla ulaştırmak, üretim süreçlerinde verimliliklerine değer katmaktır.";
    var vision = !string.IsNullOrEmpty(Model?.Vision) ? Model.Vision : "Türkiye'nin ve çevre coğrafyanın endüstriyel kalıp ekipmanları ve parlatma teknolojilerinde ilk akla gelen, kalitesiyle referans gösterilen lider markası olmak.";
    
    var mainImage = !string.IsNullOrEmpty(Model?.ImageUrl) ? Model.ImageUrl : "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80";
    var secondaryImage = !string.IsNullOrEmpty(Model?.SecondaryImageUrl) ? Model.SecondaryImageUrl : "https://images.unsplash.com/photo-1581092160607-ee22621dd758?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80";

    var expYears = !string.IsNullOrEmpty(Model?.ExperienceYears) ? Model.ExperienceYears : "25+";
    var prodCount = !string.IsNullOrEmpty(Model?.ProductCount) ? Model.ProductCount : "1500+";
    var custCount = !string.IsNullOrEmpty(Model?.CustomerCount) ? Model.CustomerCount : "500+";
    var satRate = !string.IsNullOrEmpty(Model?.SatisfactionRate) ? Model.SatisfactionRate : "%100";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center space-x-2" aria-label="Gezinti Yolu">
        <a href="/" class="hover:text-akinRed transition-colors" aria-label="Ana Sayfa"><i class="fas fa-home" aria-hidden="true"></i></a>
        <span><i class="fas fa-chevron-right text-xs" aria-hidden="true"></i></span>
        <span class="text-akinBlack font-bold">Hakkımızda</span>
    </nav>

    <!-- Ana Tanıtım & Hikaye Bölümü -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
        <!-- Sol: Katmanlı Görsel Alanı -->
        <div class="lg:col-span-5 relative">
            <div class="rounded-2xl overflow-hidden shadow-2xl border-4 border-white bg-gray-100 aspect-[4/3]">
                <img src="@mainImage" alt="Akın Teknik Kalıp Malzemeleri ve Parlatma Merkezi Ofis ve Tesisleri" class="w-full h-full object-cover" />
            </div>
            
            <!-- İkincil Küçük Görsel Rozeti -->
            @if(!string.IsNullOrEmpty(secondaryImage))
            {
                <div class="hidden sm:block absolute -bottom-8 -right-6 w-48 h-48 rounded-xl overflow-hidden shadow-xl border-4 border-white bg-white">
                    <img src="@secondaryImage" alt="Akın Teknik Endüstriyel Kalıp ve Parlatma Atölyesi" class="w-full h-full object-cover" />
                </div>
            }

            <!-- Tecrübe Rozeti -->
            <div class="absolute top-3 left-3 sm:-top-4 sm:-left-4 bg-akinRed text-white px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl shadow-lg flex items-center gap-2.5 sm:gap-3 z-10">
                <i class="fas fa-award text-2xl"></i>
                <div>
                    <span class="block text-xl font-black leading-none">@expYears</span>
                    <span class="text-xs uppercase font-medium tracking-wider opacity-90">Yıllık Güven</span>
                </div>
            </div>
        </div>

        <!-- Sağ: Kurumsal Metin & Başlık -->
        <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-akinRed text-xs font-bold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-akinRed"></span>
                Kurumsal Profilimiz
            </div>

            <h1 class="text-3xl sm:text-4xl font-black text-akinBlack leading-tight">
                @title
            </h1>

            <p class="text-lg text-gray-600 font-medium leading-relaxed">
                @subTitle
            </p>

            <div class="text-gray-600 leading-relaxed space-y-4 border-t pt-4">
                @foreach(var paragraph in content.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@paragraph</p>
                }
            </div>
        </div>
    </div>

    <!-- Sayılarla Akın Teknik (İstatistik Bandı) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition-shadow">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-red-50 text-akinRed flex items-center justify-center text-xl">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <h3 class="text-3xl font-black text-akinBlack mb-1">@expYears</h3>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Sektör Tecrübesi</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition-shadow">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-red-50 text-akinRed flex items-center justify-center text-xl">
                <i class="fas fa-boxes"></i>
            </div>
            <h3 class="text-3xl font-black text-akinBlack mb-1">@prodCount</h3>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Geniş Ürün Çeşidi</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition-shadow">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-red-50 text-akinRed flex items-center justify-center text-xl">
                <i class="fas fa-handshake"></i>
            </div>
            <h3 class="text-3xl font-black text-akinBlack mb-1">@custCount</h3>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Aktif Müşteri Ağı</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition-shadow">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-red-50 text-akinRed flex items-center justify-center text-xl">
                <i class="fas fa-smile"></i>
            </div>
            <h3 class="text-3xl font-black text-akinBlack mb-1">@satRate</h3>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Memnuniyet Oranı</p>
        </div>
    </div>

    <!-- Alt Markamız: KUZEY Bölümü -->
    <div class="bg-gradient-to-r from-gray-900 to-black text-white rounded-3xl p-8 sm:p-12 mb-16 shadow-2xl relative overflow-hidden border border-gray-800">
        <!-- Arka plan süsleme efekti -->
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-akinRed/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <!-- Sol: Kuzey Logo & Görsel Kartı -->
            <div class="lg:col-span-5 bg-black/70 rounded-2xl p-4 border border-gray-800 flex items-center justify-center shadow-inner">
                <img src="/images/kuzey.jpg" alt="Kuzey Kalıpçılık ve Parlatma Ekipmanları - Akın Teknik Tescilli Markası" class="w-full h-auto rounded-xl object-contain max-h-64 shadow-lg hover:scale-105 transition-transform duration-300" />
            </div>

            <!-- Sağ: Açıklama ve Alt Marka Vurgusu -->
            <div class="lg:col-span-7 space-y-4">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-akinRed/20 text-red-400 text-xs font-bold uppercase tracking-wider border border-akinRed/30">
                    <i class="fas fa-certificate text-akinRed"></i>
                    Tescilli Alt Markamız
                </div>

                <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
                    Kuzey Kalıpçılık ve Parlatma Ekipmanları
                </h2>

                <p class="text-gray-300 text-base leading-relaxed">
                    Sektördeki yüksek kalite ve hassasiyet standartlarımızı daha ileriye taşımak adına hayata geçirdiğimiz <strong class="text-white">KUZEY</strong> markası, <strong class="text-white">Akın Teknik</strong> bünyesinde tescil edilmiş ve geliştirilmiş özel bir alt markadır.
                </p>

                <p class="text-gray-400 text-sm leading-relaxed">
                    Kalıp parlatma keçeleri, elmas pasta ve eğeler başta olmak üzere en zorlu imalat operasyonlarında maksimum aşınma direnci ve kusursuz yüzey kalitesi sağlayan özel sarf malzemelerimiz; <strong class="text-white">Kuzey</strong> markası altında ve doğrudan Akın Teknik güvencesiyle üretilip sanayicilerimizin hizmetine sunulmaktadır.
                </p>

                <div class="pt-2 flex flex-wrap gap-4 text-xs font-semibold text-gray-300">
                    <span class="flex items-center gap-1.5 bg-gray-800/80 px-3 py-1.5 rounded-lg border border-gray-700"><i class="fas fa-check text-akinRed"></i> Akın Teknik İştiraki</span>
                    <span class="flex items-center gap-1.5 bg-gray-800/80 px-3 py-1.5 rounded-lg border border-gray-700"><i class="fas fa-check text-akinRed"></i> Yüksek Yüzey Hassasiyeti</span>
                    <span class="flex items-center gap-1.5 bg-gray-800/80 px-3 py-1.5 rounded-lg border border-gray-700"><i class="fas fa-check text-akinRed"></i> Uzun Ömürlü Kullanım</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Misyon & Vizyon Bölümü -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <!-- Misyon -->
        <div class="bg-gradient-to-br from-white to-gray-50 p-8 rounded-2xl border border-gray-100 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-akinRed"></div>
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl bg-akinRed text-white flex items-center justify-center text-xl shadow">
                    <i class="fas fa-bullseye"></i>
                </div>
                <h3 class="text-2xl font-black text-akinBlack">Misyonumuz</h3>
            </div>
            <p class="text-gray-600 leading-relaxed">
                @mission
            </p>
        </div>

        <!-- Vizyon -->
        <div class="bg-gradient-to-br from-white to-gray-50 p-8 rounded-2xl border border-gray-100 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-akinBlack"></div>
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl bg-akinBlack text-white flex items-center justify-center text-xl shadow">
                    <i class="fas fa-eye"></i>
                </div>
                <h3 class="text-2xl font-black text-akinBlack">Vizyonumuz</h3>
            </div>
            <p class="text-gray-600 leading-relaxed">
                @vision
            </p>
        </div>
    </div>

    <!-- Neden Akın Teknik? (Değerlerimiz) -->
    <div class="mb-16">
        <div class="text-center max-w-2xl mx-auto mb-10">
            <h2 class="text-2xl sm:text-3xl font-black text-akinBlack mb-3">Neden Akın Teknik?</h2>
            <p class="text-gray-500">Sanayinin güvenilir tedarikçisi olmamızı sağlayan temel ilkelerimiz.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:border-akinRed transition-colors">
                <div class="text-akinRed text-3xl mb-4">
                    <i class="fas fa-shipping-fast"></i>
                </div>
                <h4 class="text-lg font-bold text-akinBlack mb-2">Hızlı Sevkiyat & Zengin Stok</h4>
                <p class="text-sm text-gray-600 leading-relaxed">Üretiminizin durmaması için siparişlerinizi Eyüpsultan merkez depomuzdan aynı gün hızla sevk ediyoruz.</p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:border-akinRed transition-colors">
                <div class="text-akinRed text-3xl mb-4">
                    <i class="fas fa-certificate"></i>
                </div>
                <h4 class="text-lg font-bold text-akinBlack mb-2">Yüksek Standartlı Malzeme</h4>
                <p class="text-sm text-gray-600 leading-relaxed">Endüstriyel toleranslara uygun, uzun ömürlü ve aşınmaya dayanıklı birinci sınıf sarf malzemeler sunuyoruz.</p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:border-akinRed transition-colors">
                <div class="text-akinRed text-3xl mb-4">
                    <i class="fas fa-user-shield"></i>
                </div>
                <h4 class="text-lg font-bold text-akinBlack mb-2">Teknik Danışmanlık</h4>
                <p class="text-sm text-gray-600 leading-relaxed">İşinize en uygun parlatma keçesi veya elmas eğe ölçüsünü seçmeniz için deneyimli ekibimizle yanınızdayız.</p>
            </div>
        </div>
    </div>

    <!-- İletişime Çağrı (CTA Kutusu) -->
    <div class="bg-akinBlack text-white rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-2 text-center md:text-left">
            <h3 class="text-2xl sm:text-3xl font-black">Fabrikanız İçin Teklif Almak İster misiniz?</h3>
            <p class="text-gray-400 max-w-xl">Toptan alımlarınız ve düzenli sarf malzeme tedarik talepleriniz için bize ulaşın, firmanıza özel fiyat çalışması yapalım.</p>
        </div>
        <div class="flex flex-wrap gap-4">
            <a href="/Home/Contact" class="bg-akinRed hover:bg-red-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition-colors flex items-center">
                <i class="fas fa-envelope mr-2"></i> İletişime Geçin
            </a>
            <a href="/Product" class="bg-gray-800 hover:bg-gray-700 text-white font-bold py-3.5 px-6 rounded-xl transition-colors flex items-center">
                <i class="fas fa-th-large mr-2"></i> Ürünleri İnceleyin
            </a>
        </div>
    </div>
</div>
