@model AkinTeknik.Web.Models.CategoryFilterItemViewModel

@{
    var cat = Model.Category;
    var hasSub = cat.SubCategories != null && cat.SubCategories.Any();
    var isSelected = Model.SelectedCategoryId.HasValue && Model.SelectedCategoryId.Value == cat.Id;
    var isOpen = Model.ActivePathIds.Contains(cat.Id);
    var url = Model.UseSlug ? $"/Kategori/{cat.Slug}" : $"/Product?categoryId={cat.Id}";
    
    // Girinti ve çizgi sınıfı
    var indentClass = Model.Level switch
    {
        0 => "",
        1 => "ml-3 pl-2.5 border-l-2",
        2 => "ml-3 pl-2.5 border-l-2",
        _ => "ml-2.5 pl-2 border-l-2"
    };

    var borderStyle = isOpen ? "border-red-200" : "border-gray-200";
    var textStyle = Model.Level switch
    {
        0 => "text-sm font-bold text-gray-800",
        1 => "text-xs font-semibold text-gray-700",
        _ => "text-xs font-medium text-gray-600"
    };
}

<li class="pt-1">
    <div class="flex items-center justify-between rounded-xl transition-all @(isSelected ? "bg-red-50 text-akinRed border-l-4 border-akinRed font-bold shadow-xs px-3 py-2" : (isOpen && Model.Level == 0 ? "bg-gray-50/80 text-gray-900 font-bold px-3 py-2" : "hover:bg-gray-50 px-3 py-1.5 text-gray-700"))">
        <a href="@url" class="flex-grow hover:text-akinRed transition-colors flex items-center gap-1.5 @textStyle @(isSelected ? "text-akinRed font-bold" : "")">
            @if (Model.Level > 0)
            {
                <span class="text-gray-400 text-[10px] select-none">↳</span>
            }
            <span class="truncate">@cat.Name</span>
        </a>
        
        @if (hasSub)
        {
            <button type="button" onclick="toggleSubcat('sub-@cat.Id')" aria-label="@cat.Name alt kategorilerini göster/gizle" class="p-1 ml-2 text-gray-400 hover:text-akinRed focus:outline-none focus:ring-1 focus:ring-akinRed rounded transition-colors shrink-0">
                <i id="icon-@cat.Id" class="fas fa-chevron-down text-xs transition-transform duration-200 @(isOpen ? "rotate-180 text-akinRed" : "")" aria-hidden="true"></i>
            </button>
        }
        else if (isSelected)
        {
            <i class="fas fa-check text-xs text-akinRed shrink-0"></i>
        }
    </div>

    @if (hasSub)
    {
        <ul id="sub-@cat.Id" class="@(isOpen ? "" : "hidden") mt-1 space-y-1 @indentClass @borderStyle">
            @foreach (var child in cat.SubCategories.OrderBy(c => c.DisplayOrder).ThenBy(c => c.Name))
            {
                <partial name="_CategoryFilterNode" model="new AkinTeknik.Web.Models.CategoryFilterItemViewModel {
                    Category = child,
                    SelectedCategoryId = Model.SelectedCategoryId,
                    ActivePathIds = Model.ActivePathIds,
                    Level = Model.Level + 1,
                    UseSlug = Model.UseSlug
                }" />
            }
        </ul>
    }
</li>
