    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileMenuIcon = document.getElementById('mobileMenuIcon');

            if (mobileMenuBtn && mobileMenu && mobileMenuIcon) {
                mobileMenuBtn.addEventListener('click', function () {
                    const isHidden = mobileMenu.classList.contains('hidden');
                    mobileMenuBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
                    if (isHidden) {
                        mobileMenu.classList.remove('hidden');
                        mobileMenuIcon.classList.remove('fa-bars');
                        mobileMenuIcon.classList.add('fa-times');
                    } else {
                        mobileMenu.classList.add('hidden');
                        mobileMenuIcon.classList.remove('fa-times');
                        mobileMenuIcon.classList.add('fa-bars');
                    }
                });
            }

            // Çerez Onay Bildirimi Kontrolü
            const cookieBanner = document.getElementById('cookieConsentBanner');
            const acceptCookieBtn = document.getElementById('acceptCookieBtn');
            const rejectCookieBtn = document.getElementById('rejectCookieBtn');
            const whatsappBtn = document.getElementById('floatingWhatsappBtn');
            const consentKey = 'akin_cookie_consent';

            if (cookieBanner && !localStorage.getItem(consentKey)) {
                // Sayfa yüklendikten 800ms sonra göster
                setTimeout(function () {
                    cookieBanner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
                    cookieBanner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
                    if (whatsappBtn) {
                        whatsappBtn.classList.remove('bottom-5');
                        whatsappBtn.classList.add('bottom-24');
                    }
                }, 800);

                function hideCookieBanner(status) {
                    localStorage.setItem(consentKey, status);
                    document.cookie = consentKey + "=" + status + "; path=/; max-age=" + (365 * 24 * 60 * 60) + "; SameSite=Lax";
                    cookieBanner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                    cookieBanner.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
                    if (whatsappBtn) {
                        whatsappBtn.classList.remove('bottom-24');
                        whatsappBtn.classList.add('bottom-5');
                    }
                }

                if (acceptCookieBtn) {
                    acceptCookieBtn.addEventListener('click', function () {
                        hideCookieBanner('accepted');
                    });
                }

                if (rejectCookieBtn) {
                    rejectCookieBtn.addEventListener('click', function () {
                        hideCookieBanner('essential_only');
                    });
                }
            }
        });
    </script>

    <!-- Çerez (Cookie) Onay Bildirimi - Kompakt ve Ergonomik -->
    <div id="cookieConsentBanner"
        class="fixed bottom-0 left-0 right-0 sm:bottom-6 sm:left-6 sm:right-auto sm:max-w-md bg-akinBlack/95 text-white backdrop-blur-md border-t sm:border border-gray-800 p-4 sm:rounded-2xl shadow-2xl z-50 transform translate-y-full opacity-0 pointer-events-none transition-all duration-300">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
            <div class="flex items-center space-x-3">
                <i class="fas fa-cookie-bite text-akinRed text-lg shrink-0 hidden sm:inline-block"></i>
                <p class="text-gray-300 leading-snug">
                    Sitemizde teklif sepetinizi korumak ve güvenli bir deneyim sunmak için zorunlu teknik çerezler kullanılmaktadır.
                    <a href="/gizlilik-politikasi" class="text-akinRed underline hover:text-red-400 font-semibold ml-1">Detaylar</a>
                </p>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto shrink-0 pt-1 sm:pt-0">
                <button type="button" id="acceptCookieBtn"
                    class="flex-1 sm:flex-initial bg-akinRed hover:bg-red-700 text-white text-xs font-bold py-2 px-3.5 rounded-lg shadow transition-colors text-center whitespace-nowrap">
                    Kabul Et
                </button>
                <button type="button" id="rejectCookieBtn"
                    class="flex-1 sm:flex-initial bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white text-xs font-semibold py-2 px-3 rounded-lg transition-colors border border-gray-700 text-center whitespace-nowrap">
                    Kapat
                </button>
            </div>
        </div>
    </div>

    <!-- Sabit (Floating) WhatsApp Hızlı İletişim Butonu -->
    <a id="floatingWhatsappBtn"
        href="https://wa.me/905550000000?text=Merhaba,%20Ak%C4%B1n%20Teknik%20web%20sitenizden%20ula%C5%9F%C4%B1yorum.%20Bilgi%20ve%20fiyat%20almak%20istiyorum."
        target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Destek Hattı"
        class="fixed bottom-5 sm:bottom-6 right-4 sm:right-6 z-40 flex items-center bg-green-600 hover:bg-green-700 text-white p-2.5 sm:px-3.5 sm:py-2 rounded-full shadow-lg hover:shadow-green-500/40 hover:scale-105 active:scale-95 transition-all duration-300 group border border-white/80">
        
        <!-- Canlı Durum Bildirim Halkası -->
        <span class="absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-300 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-400 border border-white"></span>
        </span>

        <i class="fab fa-whatsapp text-lg sm:text-base"></i>
        <span class="hidden sm:inline-block ml-2 font-bold text-xs">
            WhatsApp ile Hızlı Fiyat Al
        </span>
    </a>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
