@inject IConfiguration _configuration
@{
    var rawTitle = ViewData["Title"]?.ToString();
    var fullTitle = string.IsNullOrEmpty(rawTitle) || rawTitle == "Ana Sayfa"
        ? "Akın Teknik | Kalıp Elemanları & Parlatma Ekipmanları"
        : (rawTitle.Contains("Akın Teknik") ? rawTitle : $"{rawTitle} - Akın Teknik");
    
    var metaDesc = ViewData["Description"]?.ToString() 
        ?? "Akın Teknik ve Kuzey markasıyla; endüstriyel kalıp sarf malzemeleri, parlatma keçeleri, elmas eğeler ve teknik ekipmanlarda güvenilir sanayi çözüm ortağınız.";
    var metaKeywords = ViewData["Keywords"]?.ToString() 
        ?? "kalıp elemanları, parlatma keçesi, elmas eğe, kuzey parlatma, kalıp sarf malzemeleri, toptan kalıpçılık, akın teknik";

    var configBaseUrl = _configuration["SiteSettings:BaseUrl"]?.TrimEnd('/');
    var siteBaseUrl = !string.IsNullOrEmpty(configBaseUrl)
        ? configBaseUrl
        : $"{Context.Request.Scheme}://{Context.Request.Host}";

    var currentUrl = $"{siteBaseUrl}{Context.Request.Path}";
    var ogImage = ViewData["OgImage"]?.ToString();
    if (string.IsNullOrEmpty(ogImage))
    {
        ogImage = $"{siteBaseUrl}/images/logo.png";
    }
    else if (!ogImage.StartsWith("http"))
    {
        ogImage = $"{siteBaseUrl}{ogImage}";
    }
    var ogType = ViewData["OgType"]?.ToString() ?? "website";
}<!DOCTYPE html>
<html lang="tr" class="bg-akinBlack">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1a1a" />
    
    <!-- SEO Temel Meta Etiketleri -->
    <title>@fullTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta name="keywords" content="@metaKeywords" />
    <meta name="author" content="Akın Teknik Hırdavat" />
    <meta name="developer" content="OES Yazılım - Orhan Efe Saçlı" />
    <meta name="designer" content="OES Yazılım - Orhan Efe Saçlı" />
    <meta name="creator" content="OES Yazılım - Orhan Efe Saçlı (www.orhanefesacli.com)" />
    <link rel="author" href="https://www.orhanefesacli.com" />
    <meta name="robots" content="@(ViewData["Robots"]?.ToString() ?? "index, follow")" />
    <link rel="canonical" href="@currentUrl" />

    <!-- Open Graph / Facebook & WhatsApp Zengin Kart Önizlemesi -->
    <meta property="og:site_name" content="Akın Teknik" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDesc" />
    <meta name="twitter:image" content="@ogImage" />

    <!-- Yapılandırılmış Veri (JSON-LD Organization Schema) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "LocalBusiness",
      "name": "Akın Teknik Hırdavat",
      "image": "@($"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png")",
      "description": "Endüstriyel kalıp elemanları, parlatma keçeleri ve elmas eğelerde güvenilir sanayi çözüm ortağınız.",
      "telephone": "+905550000000",
      "email": "info@akinteknik.com",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Topçular Mah. Rami Kışla Cad. Bilge İş Merkezi No: 49/97",
        "addressLocality": "Eyüpsultan",
        "addressRegion": "İstanbul",
        "postalCode": "34055",
        "addressCountry": "TR"
      }
    }
    </script>
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png?v=2" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        akinRed: '#da291c',
                        akinBlack: '#1a1a1a',
                        akinGray: '#f3f4f6'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            background-color: #1a1a1a !important;
        }
        /* Tarayıcı varsayılan number input yukarı/aşağı oklarını gizle (Safari, Chrome, Firefox vb.) */
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none !important;
            appearance: none !important;
            margin: 0 !important;
            display: none !important;
        }
        input[type="number"] {
            -moz-appearance: textfield !important;
            appearance: textfield !important;
        }
    </style>
</head>

